{
  "name": "bash-language-server",
  "description": "A language server for Bash",
  "author": "Mads Hartmann",
  "license": "MIT",
  "version": "5.6.0",
  "main": "./out/server.js",
  "typings": "./out/server.d.ts",
  "bin": {
    "bash-language-server": "./out/cli.js"
  },
  "files": [
    "out",
    "tree-sitter-bash.wasm",
    "parser.info",
    "README.md",
    "CHANGELOG.md",
    "GOODVIBES_PATCH.md",
    "vendor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgd34msu/goodvibes-sdk.git",
    "directory": "vendor/bash-language-server"
  },
  "upstream": {
    "name": "bash-language-server",
    "url": "https://github.com/bash-lsp/bash-language-server"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "editorconfig": "3.0.2",
    "fuzzy-search": "3.2.1",
    "node-fetch": "2.7.0",
    "turndown": "7.2.0",
    "vscode-languageserver": "8.0.2",
    "vscode-languageserver-textdocument": "1.0.12",
    "@nodelib/fs.stat": "^2.0.2",
    "@nodelib/fs.walk": "^1.2.3",
    "glob-parent": "^5.1.2",
    "merge2": "^1.3.0",
    "picomatch": "^2.3.1",
    "fill-range": "^7.1.1",
    "@goodvibes-jev/bash-zod": "npm:zod@3.24.2",
    "@goodvibes-jev/bash-web-tree-sitter": "npm:web-tree-sitter@0.24.5"
  },
  "goodvibesPatch": {
    "source": "bash-language-server@5.6.0",
    "sourceIntegrity": "sha512-DCuV+/BZAAozsp5blvi6jDnU/ZDaTpJpWM0zqwGjnirfqv7iBsMK32xOze/jipxU0PUZ6CBUKgRUMKI7Kk70Lg==",
    "reason": "Keep bundled Bash LSP while replacing editorconfig@2.0.1 -> minimatch@10.0.1 with editorconfig@3.0.2 -> minimatch@~10.2.4. Preserve fast-glob/micromatch semantics while bundling a source-patched braces3.0.3 chain for GHSA-vfj7-8cjw-p6xm.",
    "refreshPolicy": "Re-pull from upstream when a CVE advisory affects bash-language-server or its dependencies; otherwise refresh quarterly by re-running the vendor patch script against the latest upstream tag."
  },
  "devDependencies": {
    "@types/fuzzy-search": "2.1.5",
    "@types/node-fetch": "2.6.12",
    "@types/turndown": "5.0.5",
    "@types/urijs": "1.19.25"
  }
}
