{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "extends": "./api-extractor.json",
  "mainEntryPointFilePath": "<projectFolder>/terminal-shell/dist/index.d.ts",
  "bundledPackages": [],
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/terminal-shell/tsconfig.api-extractor.json",
    "overrideTsconfig": {
      "compilerOptions": {
        // The old packages resolved each other through their own package.json
        // "types" conditions (./dist/*.d.ts). In the engine they are subpaths of
        // one package whose exports name source files, so the same declaration
        // files are named here.
        "paths": {
          "@goodvibes-jev/engine/sdk/browser/agent": [
            "./sdk/dist/browser-agent.d.ts"
          ],
          "@goodvibes-jev/engine/sdk/browser/homeassistant": [
            "./sdk/dist/browser-homeassistant.d.ts"
          ],
          "@goodvibes-jev/engine/sdk/browser/knowledge": [
            "./sdk/dist/browser-knowledge.d.ts"
          ],
          "@goodvibes-jev/engine/sdk/contracts/node": [
            "./sdk/dist/contracts-node.d.ts"
          ],
          "@goodvibes-jev/engine/sdk/platform/runtime/fleet/observed": [
            "./sdk/dist/platform/runtime/fleet/observed/source.d.ts"
          ],
          "@goodvibes-jev/engine/sdk/sql-js": [
            "./sdk/dist/platform/types/sql-js.d.ts"
          ],
          "@goodvibes-jev/engine/contracts": [
            "./contracts/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/contracts/*": [
            "./contracts/dist/*.d.ts",
            "./contracts/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/daemon-sdk": [
            "./daemon-sdk/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/daemon-sdk/*": [
            "./daemon-sdk/dist/*.d.ts",
            "./daemon-sdk/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/errors": [
            "./errors/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/errors/*": [
            "./errors/dist/*.d.ts",
            "./errors/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/operator-sdk": [
            "./operator-sdk/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/operator-sdk/*": [
            "./operator-sdk/dist/*.d.ts",
            "./operator-sdk/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/peer-sdk": [
            "./peer-sdk/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/peer-sdk/*": [
            "./peer-sdk/dist/*.d.ts",
            "./peer-sdk/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/sdk": [
            "./sdk/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/sdk/*": [
            "./sdk/dist/*.d.ts",
            "./sdk/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/terminal-shell": [
            "./terminal-shell/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/terminal-shell/*": [
            "./terminal-shell/dist/*.d.ts",
            "./terminal-shell/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/toolchain": [
            "./toolchain/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/toolchain/*": [
            "./toolchain/dist/*.d.ts",
            "./toolchain/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/transport-core": [
            "./transport-core/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/transport-core/*": [
            "./transport-core/dist/*.d.ts",
            "./transport-core/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/transport-http": [
            "./transport-http/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/transport-http/*": [
            "./transport-http/dist/*.d.ts",
            "./transport-http/dist/*/index.d.ts"
          ],
          "@goodvibes-jev/engine/transport-realtime": [
            "./transport-realtime/dist/index.d.ts"
          ],
          "@goodvibes-jev/engine/transport-realtime/*": [
            "./transport-realtime/dist/*.d.ts",
            "./transport-realtime/dist/*/index.d.ts"
          ]
        }
      }
    }
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "goodvibes-terminal-shell.api.md",
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/temp/"
  }
}
