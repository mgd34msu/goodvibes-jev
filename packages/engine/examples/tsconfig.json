{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "composite": false,
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "noEmit": true,
    "types": [
      "node",
      "bun"
    ],
    // The examples consume the published declarations: with the source
    // condition turned off, every @goodvibes-jev import resolves the "types"
    // condition of the package's exports, the dist declarations a consumer
    // install sees.
    "customConditions": []
  },
  "include": [
    // Examples intentionally cover JavaScript, TypeScript, and ESM entry
    // points only; native mobile snippets live in docs, not this typecheck.
    "*.mjs",
    "*.ts",
    "*.tsx"
  ]
}
