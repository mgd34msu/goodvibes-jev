{
  "name": "@goodvibes-jev/webui",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "GoodVibes WebUI 2.0 over the workspace engine; semantic judgment and contract-tree migration remains in progress.",
  "scripts": {
    "dev": "vite",
    "build": "bun run generated:check && vite build",
    "presentation:generate": "bun run scripts/generate-presentation-tokens.ts",
    "config-schema:generate": "bun run scripts/generate-config-schema.ts",
    "config-ownership:generate": "bun run scripts/generate-config-ownership.ts",
    "preview": "vite preview --host 127.0.0.1 --port 3423 --strictPort",
    "pretest": "bun run scripts/sweep-stale-temp.ts",
    "test": "bun ../../packages/engine/scripts/test.ts --cwd ../../products/webui --isolate",
    "pretest:changed": "bun run scripts/sweep-stale-temp.ts",
    "test:changed": "bun ../../packages/engine/scripts/test.ts --cwd ../../products/webui --changed=origin/main --isolate",
    "pretest:live": "bun run scripts/sweep-stale-temp.ts",
    "test:live": "bun run scripts/live-daemon-smoke-runner.ts",
    "e2e": "playwright test",
    "e2e:phone": "playwright test --project=phone",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:release": "playwright test --project=desktop --project=lan-origin",
    "typecheck": "bun run typecheck:src && bun run typecheck:scripts && bun run typecheck:e2e && bun run typecheck:coverage",
    "typecheck:src": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts --noEmit",
    "typecheck:e2e": "tsc -p e2e --noEmit",
    "typecheck:coverage": "bun run scripts/typecheck-coverage.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:bundle": "bun run scripts/pack-bundle.ts",
    "release:gate": "bun run scripts/release-gate.ts",
    "release:prepare": "bun run scripts/release-prepare.ts",
    "generated:check": "bun run scripts/check-generated.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@tanstack/react-query": "^5.100.11",
    "highlight.js": "^11.11.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.16.0",
    "onnxruntime-web": "1.27.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "@goodvibes-jev/engine": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "20.10.6",
    "@playwright/test": "^1.61.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "happy-dom": "^20.10.6",
    "prettier": "3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "^8.0.13"
  }
}
