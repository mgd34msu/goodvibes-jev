{
  "name": "@goodvibes-jev/daemon",
  "version": "1.28.25",
  "private": true,
  "type": "module",
  "description": "Partial daemon command executable and explicitly composed, owned runtime host.",
  "license": "MIT",
  "engines": {
    "bun": "1.3.14",
    "node": ">=22.0.0"
  },
  "exports": {
    "./cli": {
      "bun": "./src/cli/index.ts",
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun run build && bun ../../packages/engine/scripts/test.ts --cwd ../../products/daemon src/test",
    "start": "bun dist/cli/entrypoint.js"
  },
  "dependencies": {
    "@goodvibes-jev/engine": "workspace:*"
  },
  "devDependencies": {
    "@goodvibes-jev/judgment": "workspace:*"
  },
  "bin": {
    "goodvibes-daemon": "./dist/cli/entrypoint.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "migration.json"
  ]
}
