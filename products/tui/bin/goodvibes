#!/usr/bin/env bun
import { accessSync, constants } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const platform = process.platform === 'darwin' ? 'macos' : process.platform;
const suffix = process.platform === 'win32' ? '.exe' : '';
const candidates = [join(root, 'dist', `goodvibes-${platform}-${process.arch}${suffix}`), join(root, 'dist', `goodvibes${suffix}`)];
const executable = candidates.find(path => {
  try { accessSync(path, constants.X_OK); return true; } catch { return false; }
});
if (!executable) {
  console.error('goodvibes: this private Jev workspace has no built TUI binary.');
  console.error('Build the workspace engine, then run bun run --filter @goodvibes-jev/tui build from the workspace root.');
  process.exit(1);
}
const child = spawnSync(executable, process.argv.slice(2), { stdio: 'inherit' });
if (child.error) { console.error(`goodvibes: could not launch the workspace binary: ${child.error.message}`); process.exit(1); }
if (child.signal) { process.kill(process.pid, child.signal); process.exit(1); }
process.exit(child.status ?? 1);
