{
  "name": "goodvibes-jev",
  "private": true,
  "version": "2.0.23",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": ">=22.0.0"
  },
  "description": "The goodvibes platform with Jev judgment built in: the judgment foundation, the engine, and the daemon, TUI, agent and web UI products.",
  "license": "MIT",
  "homepage": "https://github.com/mgd34msu/goodvibes-jev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgd34msu/goodvibes-jev.git"
  },
  "bugs": {
    "url": "https://github.com/mgd34msu/goodvibes-jev/issues"
  },
  "workspaces": [
    "packages/*",
    "products/*"
  ],
  "scripts": {
    "build": "bun packages/engine/scripts/build.ts",
    "prepare:sdk": "bun packages/engine/scripts/prepare-sdk-package.ts",
    "sync:version": "bun packages/engine/scripts/sync-version-fallback.ts",
    "refresh:contracts": "bun packages/engine/scripts/refresh-contract-artifacts.ts && bun packages/engine/scripts/generate-foundation-io-entries.ts && bun packages/engine/scripts/generate-openapi-contract.ts && bun packages/engine/scripts/generate-webui-facade.ts && bun packages/engine/scripts/generate-homeassistant-client.ts",
    "foundation-io:generate": "bun packages/engine/scripts/generate-foundation-io-entries.ts",
    "webui-facade:generate": "bun packages/engine/scripts/generate-webui-facade.ts",
    "webui-facade:check": "bun packages/engine/scripts/generate-webui-facade.ts --check",
    "homeassistant-client:generate": "bun packages/engine/scripts/generate-homeassistant-client.ts",
    "homeassistant-client:check": "bun packages/engine/scripts/generate-homeassistant-client.ts --check",
    "refresh:docs": "bun run refresh:contracts && bun run docs:generate",
    "docs:generate": "bun packages/engine/scripts/generate-api-docs.ts",
    "api:extract": "bunx api-extractor run --local --config packages/engine/api-extractor.json && bunx api-extractor run --local --config packages/engine/api-extractor.embed.json && bunx api-extractor run --local --config packages/engine/api-extractor.terminal-shell.json && bun packages/engine/scripts/normalize-api-eol.ts",
    "pretest": "bun packages/engine/scripts/typecheck.ts",
    "test": "bun run test:judgment && bun packages/engine/scripts/test.ts",
    "test:judgment": "bun packages/engine/scripts/test.ts --cwd ../judgment test",
    "test:rn": "bun packages/engine/scripts/test.ts test/rn-bundle-node-imports.test.ts",
    "test:workers": "bun packages/engine/scripts/test.ts test/workers/workers.test.ts",
    "test:workers:wrangler": "bun packages/engine/scripts/test.ts test/workers-wrangler/wrangler.test.ts",
    "sweep:wake-race": "bun packages/engine/scripts/sweep-wake-race.ts",
    "any:check": "bun packages/engine/scripts/no-any-types.ts",
    "architecture:check": "bun packages/engine/scripts/test-tmp-architecture-check.ts",
    "api:check": "bun run api:extract && git diff --quiet -- packages/engine/etc/goodvibes-sdk.api.md packages/engine/etc/goodvibes-sdk-embed.api.md packages/engine/etc/goodvibes-terminal-shell.api.md && bun run api:subpath:check",
    "subpath:declared:check": "bun packages/engine/scripts/check-subpath-declared.ts",
    "bundle:check": "bun packages/engine/scripts/bundle-budget.ts",
    "bundle:init": "bun packages/engine/scripts/plugin-bundle.ts init",
    "bundle:validate": "bun packages/engine/scripts/plugin-bundle.ts validate",
    "changelog:check": "bun packages/engine/scripts/check-changelog.ts",
    "check:browser": "bun packages/engine/scripts/browser-compat-check.ts",
    "check:metadata": "bun packages/engine/scripts/package-metadata-check.ts",
    "package-readmes:read": "bun packages/engine/scripts/read-package-readmes.ts",
    "contracts:check": "bun packages/engine/scripts/check-contract-artifacts.ts",
    "credential-scope:check": "bun packages/engine/scripts/check-credential-scope.ts",
    "credential-keys:read": "bun packages/engine/scripts/read-credential-keys.ts",
    "error-kinds:read": "bun packages/engine/scripts/read-stale-error-kinds.ts",
    "contracts:foundation-io:check": "bun packages/engine/scripts/check-foundation-io-types.ts --check",
    "contracts:foundation-io:coverage": "bun packages/engine/scripts/check-foundation-io-coverage.ts --check",
    "dist:check": "bun packages/engine/scripts/check-dist-freshness.ts",
    "docs:check": "bun packages/engine/scripts/generate-api-docs.ts --check && bun packages/engine/scripts/docs-completeness-check.ts",
    "error:check": "bun packages/engine/scripts/error-contract-check.ts",
    "eval:gate": "bun packages/engine/scripts/eval-gate.ts",
    "eval:baseline": "bun packages/engine/scripts/eval-baseline.ts",
    "eval:baseline:check": "bun packages/engine/scripts/eval-baseline.ts --check",
    "observe:report": "bun packages/engine/scripts/observe-report.ts",
    "observe:proof": "bun packages/engine/scripts/observe-proof.ts",
    "judgment:lint": "bun packages/engine/scripts/judgment-lint.ts",
    "flags:graduation": "bun packages/engine/scripts/flags-graduation.ts",
    "internal-id:check": "bun packages/engine/scripts/check-internal-identifiers.ts",
    "openapi:generate": "bun packages/engine/scripts/generate-openapi-contract.ts",
    "openapi:check": "bun packages/engine/scripts/generate-openapi-contract.ts --check",
    "pack:check": "bun packages/engine/scripts/pack-check.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "platform-console:check": "bun packages/engine/scripts/no-platform-console.ts",
    "publint:check": "bun packages/engine/scripts/publint-check.ts",
    "refresh:contracts:check": "bun packages/engine/scripts/refresh-contract-artifacts.ts --check",
    "security:audit": "bun audit --audit-level high",
    "todo:check": "bun packages/engine/scripts/no-todo-markers.ts",
    "typecheck": "bun packages/engine/scripts/typecheck.ts",
    "types:check": "node node_modules/typescript/bin/tsc --project packages/engine/tsconfig.type-tests.json",
    "types:resolution-check": "bun packages/engine/scripts/types-resolution-check.ts",
    "version:check": "bun packages/engine/scripts/version-consistency-check.ts",
    "validate": "bun packages/engine/scripts/validate.ts",
    "validate:strict": "bun run validate && bun run types:check && bun run contracts:check",
    "install:smoke": "bun packages/engine/scripts/install-smoke-check.ts",
    "release:artifact-lane": "bun packages/engine/scripts/release-artifact-lane.ts",
    "release:dry-run": "bun packages/engine/scripts/publish-packages.ts --dry-run",
    "release:publish": "bun packages/engine/scripts/publish-packages.ts",
    "release:publish:ci": "bun packages/engine/scripts/publish-packages.ts --provenance",
    "release:tag": "bun packages/engine/scripts/create-release-tag.ts",
    "release:verify": "bun run validate && bun run flags:graduation && bun run security:audit && bun run test && bun run test:rn && bun run test:workers && bun run test:workers:wrangler && bun run release:dry-run && bun run install:smoke",
    "release:verify:published": "bun packages/engine/scripts/verify-published-packages.ts && bun packages/engine/scripts/install-smoke-check.ts --registry",
    "release:verify:verdaccio": "bun packages/engine/scripts/verdaccio-dry-run.ts",
    "bundle:check:strict": "bun packages/engine/scripts/bundle-budget.ts --no-build",
    "api:subpath": "bun packages/engine/scripts/check-subpath-api-surface.ts",
    "api:subpath:check": "bun packages/engine/scripts/check-subpath-api-surface.ts --check",
    "exports:check": "bun packages/engine/scripts/check-exports-coverage.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@ast-grep/napi": "0.42.1",
    "@cloudflare/workers-types": "4.20260503.1",
    "@microsoft/api-extractor": "7.58.7",
    "@types/bun": "1.3.14",
    "@types/jsdom": "28.0.1",
    "@types/node": "22.16.5",
    "fast-check": "4.7.0",
    "miniflare": "4.20260430.0",
    "msw": "2.14.2",
    "publint": "0.3.18",
    "typescript": "6.0.3",
    "verdaccio": "6.5.2",
    "wrangler": "4.87.0",
    "zod": "4.4.3"
  },
  "dependencies": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0",
    "undici": "^7.29.0"
  },
  "overrides": {
    "ajv": "8.18.0",
    "fast-uri": "^3.1.5",
    "fast-xml-parser": "5.7.1",
    "google-auth-library": "10.6.2",
    "bash-language-server": "file:vendor/bash-language-server",
    "lodash": "4.18.1",
    "minimatch": "^10.2.5",
    "uuid": "file:vendor/uuid-cjs",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "ws": "8.21.0",
    "undici": "^7.29.0",
    "tar": "^7.5.16",
    "brace-expansion": "^5.0.9",
    "sharp": "^0.35.0",
    "js-yaml": "^4.3.1",
    "ip-address": "^10.4.0"
  },
  "overridesRationale": {
    "ajv": "Pinned to keep JSON Schema validation on the audited 8.x line used by release tooling dependencies.",
    "bash-language-server": "Vendored to keep shell language support while preserving a clean high-severity audit surface for the Verdaccio dry-run dependency graph.",
    "fast-xml-parser": "Pinned to the audited 5.x parser release used by transitive Google/Cloud tooling.",
    "fast-uri": "Pinned to 3.1.2 to avoid GHSA-v39h-62p7-jpjc in AJV consumers used by release tooling.",
    "google-auth-library": "Pinned to an audited release for Cloudflare/Wrangler transitive auth tooling.",
    "lodash": "Pinned to 4.18.1 (latest stable; outside the >=4.0.0 <=4.17.23 vulnerable range from GHSA-r5fr-rjxr-66jc, Code Injection via _.template). Bumped from 4.17.21 to escape the audit advisory.",
    "minimatch": "Pinned to a patched glob matcher across build and release transitive dependencies.",
    "uuid": "Vendored CommonJS uuid v4 package for Verdaccio @cypress/request, which still requires a CommonJS uuid entry.",
    "esbuild": "Pinned to 0.28.1 to close GHSA-gv7w-rqvm-qjhr (missing binary integrity verification in Deno module, enabling RCE via NPM_CONFIG_REGISTRY). Wrangler 4.x pins esbuild <0.28.1; this override forces the patched release across all transitive consumers.",
    "form-data": "Pinned to 4.0.6 to close GHSA-hmw2-7cc7-3qxx (CRLF injection via unescaped multipart field/file names). Forces the patched release across @cypress/request (Verdaccio) and Cloudflare transitive consumers.",
    "ws": "Pinned to 8.21.0 to close GHSA-96hv-2xvq-fx4p (memory-exhaustion DoS from tiny fragments). Minor bump within the 8.x line forced across miniflare, node-edge-tts, and the openai ws peer.",
    "undici": "Pinned to 7.28.0 to close GHSA-vmh5-mc38-953g, GHSA-vxpw-j846-p89q, and GHSA-hm92-r4w5-c3mj (TLS bypass, WebSocket DoS, SOCKS5 routing). Kept on the 7.x line that jsdom (^7.25.0) and miniflare require; 8.x would be a breaking major."
  }
}
