#!/usr/bin/env bash
# Keep the local commit path limited to the source-only credential check.
# Full build, types, API, product, browser and containment checks run in CI;
# use bun run validate locally when a complete integration check is needed.
# A successful local commit does not establish merge readiness.
set -euo pipefail

# Keep credential checking for engine and product source/manifests/config.
# Documentation-only edits do not invoke application tooling.
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(packages/engine/([^/]+/src/.*\.ts|package\.json)|products/[^/]+/((src|scripts)/.*\.[cm]?[jt]sx?|package\.json|tsconfig([^/]*)\.json|migration\.json))$' || true)
if [ -z "$STAGED_SRC" ]; then
  exit 0
fi

echo "[pre-commit] running credential-scope:check, a stored credential must be classified"

if ! bun run credential-scope:check; then
  echo "" >&2
  echo "[pre-commit] BLOCKED: credential-scope-check failed (see above)." >&2
  echo "" >&2
  echo "  A credential nothing classifies is a credential nothing can route, and" >&2
  echo "  that is how a capability ends up silently dead on the daemon while" >&2
  echo "  working credentials sit on the same disk." >&2
  echo "" >&2
  echo "  Correct the classification or source finding before committing" >&2
  exit 1
fi
